{
  "name": "neon-breach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/local-preview.ts",
    "build": "tsc --noEmit && vite build && node scripts/package-function.mjs",
    "start": "tsx scripts/local-preview.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "tsx tests/netlify-browser.ts",
    "check": "tsc --noEmit",
    "test:netlify": "tsx tests/netlify.test.ts",
    "package:netlify": "python3 scripts/package-netlify.py",
    "test:touch": "tsx tests/netlify-touch.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^6.0.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.2.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
